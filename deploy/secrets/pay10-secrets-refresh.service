[Unit]
Description=Re-fetch Pay10 frontend secrets and restart the app to pick them up

[Service]
Type=oneshot
Environment=PAY10_SECRET_ID=pay10/frontend
Environment=AWS_REGION=ap-south-1
Environment=PAY10_SECRET_DIR=/run/pay10-secrets
ExecStart=/usr/local/bin/pay10-secrets.sh
# Only restart the app if the fetch succeeded — systemd stops at the first failing
# ExecStart, so a failed rotation leaves the running app on its previous secret
# rather than reloading it with nothing.
ExecStart=/usr/bin/pm2 restart dpay1-staging --update-env
