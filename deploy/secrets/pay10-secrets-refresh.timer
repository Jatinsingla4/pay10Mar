[Unit]
Description=Re-fetch Pay10 frontend secrets so a rotation is picked up

[Timer]
# The app reads its secrets once at startup, so a rotated secret only takes effect
# after a restart. This re-fetches daily; pair it with the refresh service below.
OnCalendar=daily
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
