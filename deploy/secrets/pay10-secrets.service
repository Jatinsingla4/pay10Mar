[Unit]
Description=Fetch Pay10 frontend secrets from AWS Secrets Manager
Documentation=file:///opt/pay10/deploy/secrets/README.md
# Needs the network and the instance role's credentials endpoint to be reachable.
After=network-online.target
Wants=network-online.target
# The app reads its secrets once at startup, so they have to exist first. pm2's
# generated unit is usually pm2-root.service — change this if the app is started by
# something else, and keep the app unit's `After=pay10-secrets.service` in step.
Before=pm2-root.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PAY10_SECRET_ID=pay10/frontend
Environment=AWS_REGION=ap-south-1
Environment=PAY10_SECRET_DIR=/run/pay10-secrets
ExecStart=/usr/local/bin/pay10-secrets.sh

# A failed fetch must not let the app come up on a stale or empty secret — an empty
# reCAPTCHA key would otherwise mean serving with bot protection off.
Restart=no

[Install]
WantedBy=multi-user.target
